NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=connectly_db

# Use a random value with at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRES_IN=12h

# Required only while running: npm run create-admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_PASSWORD=ChangeMe12345
